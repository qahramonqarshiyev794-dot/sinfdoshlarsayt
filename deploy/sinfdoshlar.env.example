# Copy to /etc/sinfdoshlar.env and replace both placeholder credentials.
ADMIN_USERNAME=replace-with-admin-login
ADMIN_PASSWORD=replace-with-a-long-random-password
HOST=127.0.0.1
PORT=8000
COOKIE_SECURE=1
DATA_DIR=/var/lib/sinfdoshlar
TRUSTED_PROXY_IPS=127.0.0.1,::1
INITIAL_VIDEO_TITLE=Sinfdoshlar uchun video
INITIAL_VIDEO_URL=
