[Unit]
Description=Sinfdoshlar private video site
After=network.target

[Service]
Type=simple
User=sinfdoshlar
Group=sinfdoshlar
WorkingDirectory=/opt/sinfdoshlar
EnvironmentFile=/etc/sinfdoshlar.env
ExecStart=/usr/bin/python3 /opt/sinfdoshlar/server.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sinfdoshlar

[Install]
WantedBy=multi-user.target
